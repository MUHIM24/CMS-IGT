# Contoh variabel environment (salin ke .env.local untuk lokal, isi di Vercel > Settings > Environment Variables untuk production).
# JANGAN isi nilai asli di file ini: repo GitHub publik.

# Login dashboard /admin (tahap tampilan, akun tunggal). Kosong = login ditolak.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# String acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Opsional: meta tag verifikasi Google Search Console (sekarang verifikasi lewat file public/google58b6fa4063452ad3.html)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
